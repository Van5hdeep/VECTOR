# VECTOR_CORE Environment Configuration
# The API key is never exposed to the browser/frontend.

VECTOR_CORE_API_KEY=
VECTOR_CORE_MODEL=openai/gpt-oss-120b

# ElevenLabs TTS Configuration
# The API key is never exposed to the browser/frontend.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# VECTOR Lock Screen
VECTOR_LOCK_PASSWORD=your-development-password

# Fish Audio TTS Configuration
# The API key is never exposed to the browser/frontend.
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=

# Web search: Tavily (free 1,000 searches/month, no card) — https://app.tavily.com
TAVILY_API_KEY=

# Alternative: Brave Search API (used only if TAVILY_API_KEY is empty)
BRAVE_SEARCH_API_KEY=

# Optional: folders VECTOR's file tools may access (semicolon-separated).
# Defaults to your Documents, Desktop and Downloads folders.
# VECTOR_FILE_ROOTS=C:\Users\you\Documents;C:\Desktop
