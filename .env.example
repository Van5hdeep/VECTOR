# VECTOR_CORE Environment Configuration
# The API key is never exposed to the browser/frontend.

VECTOR_CORE_API_KEY=
VECTOR_CORE_MODEL=openai/gpt-oss-120b

# Fallback language model: Google Gemini (free key from https://aistudio.google.com/apikey).
# Used when Groq's main model is rate limited (daily or per-minute); the Groq utility model is the last resort.
# Free-tier limits differ per model (check aistudio.google.com/rate-limit). The free tier may
# use prompts to improve Google products (a paid/billing-enabled project does not).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Voice: VECTOR speaks with a local Kokoro model (deep android, "Michael") — no key needed.
# The model (~90 MB) downloads automatically on first start.

# VECTOR Lock Screen
VECTOR_LOCK_PASSWORD=your-development-password

# Web search: Tavily (free 1,000 searches/month, no card) — https://app.tavily.com
TAVILY_API_KEY=

# Alternative: Brave Search API (used only if TAVILY_API_KEY is empty)
BRAVE_SEARCH_API_KEY=

# Optional: folders VECTOR's file tools may access (semicolon-separated).
# Defaults to your Documents, Desktop and Downloads folders.
# VECTOR_FILE_ROOTS=C:\Users\you\Documents;C:\Desktop

# Optional: cheap model for background chores (conversation titles, summaries).
# Groq rate limits are per model, so this keeps the main model's budget free.
# VECTOR_UTILITY_MODEL=openai/gpt-oss-20b

# Optional: morning briefing. Set a local time (24h HH:MM) and VECTOR delivers a spoken-style
# summary of today's calendar, reminders, unread mail (and weather) as a new conversation.
# Unset = only on request ("brief me"). If the server was off at that time it still delivers
# when started within 3 hours after it.
# VECTOR_BRIEFING_TIME=07:30
# Weather for the briefing (Open-Meteo, no key). Find your coordinates on any map site.
# VECTOR_BRIEFING_LAT=
# VECTOR_BRIEFING_LON=

# Optional: speaking speed of VECTOR's voice (default 1.35; 1.0 = Kokoro's native pace)
# VECTOR_VOICE_SPEED=1.35
